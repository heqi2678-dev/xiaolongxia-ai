# 铜龙铺货后端环境变量（复制到 /etc/xlx-dropship.env 后按需修改）
# 只监听本机回环，由扩展或前端页面访问
DROPSHIP_HOST=127.0.0.1
DROPSHIP_PORT=9150
DROPSHIP_DATA_DIR=/home/admin/work/dropship-data

# 扩展/前端访问令牌；非空时 /api/* 需 Authorization: Bearer <token>
DROPSHIP_EXT_TOKEN=

# 发布限频（每分钟）与失败重试次数
DROPSHIP_RATE_PER_MIN=30
DROPSHIP_MAX_RETRIES=3

# 1=试运行（不真正调用平台 API）；完成平台授权并核对无误后改为 0
DROPSHIP_DRY_RUN=1

# 平台自用型应用凭据（完成开发者认证后从开放平台获取）
DROPSHIP_TAOBAO_APP_KEY=
DROPSHIP_TAOBAO_APP_SECRET=
DROPSHIP_TIKTOK_APP_KEY=
DROPSHIP_TIKTOK_APP_SECRET=
