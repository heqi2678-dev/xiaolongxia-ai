{
  "manifest_version": 3,
  "name": "小龙虾 · 1688 采集",
  "version": "1.0.0",
  "description": "在 1688 商品页 / 列表页一键采集到小龙虾电商工作台，图片由后端转存。",
  "permissions": ["storage", "tabs", "scripting", "activeTab"],
  "host_permissions": ["https://*.1688.com/*"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "小龙虾采集" },
  "content_scripts": [
    {
      "matches": ["https://*.1688.com/*"],
      "js": ["parsers/1688.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
